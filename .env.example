# Same database the legacy PHP app uses, or a migrated copy.
# Do not assume host, credentials, database name, or schema state.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# LINE Login channel (LINE Developers Console > Provider > LINE Login channel > Basic settings)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# Must exactly match a Callback URL registered on the channel's LINE Login tab.
LINE_REDIRECT_URI="http://localhost:3000/api/auth/line/callback"

# HMAC key for signing the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

NEXT_PUBLIC_LIFF_ID=""
